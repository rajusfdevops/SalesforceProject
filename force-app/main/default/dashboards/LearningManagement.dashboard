<?xml version="1.0" encoding="UTF-8"?>
<Dashboard xmlns="http://soap.sforce.com/2006/04/metadata">
    <backgroundEndColor>#FFFFFF</backgroundEndColor>
    <backgroundFadeDirection>Diagonal</backgroundFadeDirection>
    <backgroundStartColor>#FFFFFF</backgroundStartColor>
    <chartTheme>light</chartTheme>
    <dashboardChartTheme>light</dashboardChartTheme>
    <dashboardFilters/>
    <dashboardGridLayout>
        <dashboardGridComponents>
            <colSpan>3</colSpan>
            <columnNumber>1</columnNumber>
            <componentType>Metric</componentType>
            <dashboardComponent>
                <dashboardComponentType>Metric</dashboardComponentType>
                <displayUnits>Integer</displayUnits>
                <label>Completed Enrollments</label>
                <query>SELECT COUNT() FROM Enrollment__c WHERE Status__c = 'Completed'</query>
                <showTrendIcon>true</showTrendIcon>
            </dashboardComponent>
            <rowNumber>1</rowNumber>
        </dashboardGridComponents>
        <dashboardGridComponents>
            <colSpan>3</colSpan>
            <columnNumber>4</columnNumber>
            <componentType>Metric</componentType>
            <dashboardComponent>
                <dashboardComponentType>Metric</dashboardComponentType>
                <displayUnits>Integer</displayUnits>
                <label>Not Started Enrollments</label>
                <query>SELECT COUNT() FROM Enrollment__c WHERE Status__c = 'Not Started'</query>
                <showTrendIcon>true</showTrendIcon>
            </dashboardComponent>
            <rowNumber>1</rowNumber>
        </dashboardGridComponents>
        <dashboardGridComponents>
            <colSpan>3</colSpan>
            <columnNumber>7</columnNumber>
            <componentType>Metric</componentType>
            <dashboardComponent>
                <dashboardComponentType>Metric</dashboardComponentType>
                <displayUnits>Integer</displayUnits>
                <label>In Progress Enrollments</label>
                <query>SELECT COUNT() FROM Enrollment__c WHERE Status__c = 'In Progress'</query>
                <showTrendIcon>true</showTrendIcon>
            </dashboardComponent>
            <rowNumber>1</rowNumber>
        </dashboardGridComponents>
        <dashboardGridComponents>
            <colSpan>12</colSpan>
            <columnNumber>1</columnNumber>
            <componentType>Table</componentType>
            <dashboardComponent>
                <dashboardComponentType>Table</dashboardComponentType>
                <label>Course Enrollments - Recent Activity</label>
                <query>SELECT Student__r.First_Name__c, Student__r.Last_Name__c, Student__r.Email__c, Course__r.Title__c, Progress__c, CreatedDate, Name FROM Enrollment__c ORDER BY CreatedDate DESC LIMIT 10</query>
            </dashboardComponent>
            <rowNumber>3</rowNumber>
        </dashboardGridComponents>
        <dashboardGridComponents>
            <colSpan>6</colSpan>
            <columnNumber>1</columnNumber>
            <componentType>BarChart</componentType>
            <dashboardComponent>
                <chartSummary>
                    <aggregate>COUNT</aggregate>
                    <axisBinding>y</axisBinding>
                </chartSummary>
                <dashboardComponentType>BarChart</dashboardComponentType>
                <groupingColumn>Status__c</groupingColumn>
                <label>Enrollments by Status</label>
                <query>SELECT Status__c FROM Enrollment__c</query>
            </dashboardComponent>
            <rowNumber>5</rowNumber>
        </dashboardGridComponents>
        <dashboardGridComponents>
            <colSpan>6</colSpan>
            <columnNumber>7</columnNumber>
            <componentType>BarChart</componentType>
            <dashboardComponent>
                <chartSummary>
                    <aggregate>COUNT</aggregate>
                    <axisBinding>y</axisBinding>
                </chartSummary>
                <dashboardComponentType>BarChart</dashboardComponentType>
                <groupingColumn>Course__r.Category__c</groupingColumn>
                <label>Enrollments by Course Category</label>
                <query>SELECT Course__r.Category__c FROM Enrollment__c</query>
            </dashboardComponent>
            <rowNumber>5</rowNumber>
        </dashboardGridComponents>
    </dashboardGridLayout>
    <dashboardType>SpecifiedUser</dashboardType>
    <description>Learning Management System Dashboard - Overview of students, courses, and enrollments</description>
    <isHeaderVisible>true</isHeaderVisible>
    <isLeftSidebarVisible>true</isLeftSidebarVisible>
    <isRightSidebarVisible>true</isRightSidebarVisible>
    <runningUser>rkmishra2703_mkqpqejtzhus@gmail.com.dev</runningUser>
    <textColor>#000000</textColor>
    <title>Learning Management Dashboard</title>
</Dashboard>
