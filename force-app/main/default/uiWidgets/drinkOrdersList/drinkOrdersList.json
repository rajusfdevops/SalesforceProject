{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": { "gap": "lg" },
          "children": [
            {
              "definition": "tile/container",
              "children": [
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "🥤 {!$attrs.summaryLine}",
                    "variant": "h3",
                    "weight": "semibold"
                  }
                }
              ]
            },
            {
              "definition": "tile/separator"
            },
            {
              "definition": "tile/container",
              "meta": {
                "forEach": "{!$attrs.orders}"
              },
              "children": [
                {
                  "definition": "tile/column",
                  "attributes": { "gap": "sm" },
                  "children": [
                    {
                      "definition": "tile/row",
                      "attributes": { "gap": "sm", "align": "center", "justify": "between" },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Order #{!$Item.orderNumber}",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/badge",
                          "attributes": {
                            "label": "{!$Item.status}",
                            "variant": "{!$Item.statusColor}"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/row",
                      "attributes": { "gap": "sm" },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Qty {!$Item.quantity}",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$Item.price}",
                            "variant": "caption",
                            "weight": "semibold"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
