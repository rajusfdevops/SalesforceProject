<apex:page showHeader="false" sidebar="false" standardStylesheets="false" applyBodyTag="false" docType="html-5.0">
    <html>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Recipe React App</title>
        <style>
            * { margin: 0; padding: 0; box-sizing: border-box; }
            html, body { width: 100%; height: 100%; overflow: hidden; }
            body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell'; }
            .app-container { width: 100%; height: 100%; }
            .loading { display: flex; align-items: center; justify-content: center; height: 100vh; font-size: 18px; color: #666; }
        </style>
    </head>
    <body>
        <div class="app-container">
            <iframe id="recipeApp"
                    src="{!$Resource.RecipeExplorer}/index.html"
                    style="width:100%; height:100%; border:none; margin:0; padding:0;"
                    title="Recipe Explorer App">
            </iframe>
        </div>
        <script>
            console.log('Recipe React App loaded from:', '{!$Resource.RecipeExplorer}');
        </script>
    </body>
    </html>
</apex:page>
