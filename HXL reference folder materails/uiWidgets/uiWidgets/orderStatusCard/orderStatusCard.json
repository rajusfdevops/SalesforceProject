                          "weight": "semibold"
                        }
                      },
                      {
                        "definition": "tile/text",
                        "attributes": {
                          "text": "{!$attrs.status}",
                          "variant": "body"
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  }
  